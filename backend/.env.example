# Copy to backend/.env and fill in. Never commit .env.

# "mock" returns a canned damage report (no API key needed).
# "claude" sends the photo to the Claude API.
CRASHTIMATE_DETECTOR=mock

# Required when CRASHTIMATE_DETECTOR=claude. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

CRASHTIMATE_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CRASHTIMATE_CLAUDE_EFFORT=medium

CRASHTIMATE_MAX_UPLOAD_MB=10
# Longest edge in pixels after resizing, before the image is sent to the model.
CRASHTIMATE_MAX_IMAGE_EDGE=1568

# JSON list of origins allowed to call the API from a browser.
CRASHTIMATE_CORS_ORIGINS=["http://localhost:3000"]

# Most photos accepted in one estimate.
CRASHTIMATE_MAX_PHOTOS=4

# SQLite file for cached analyses and saved estimates. Defaults to backend/crashtimate.db.
# CRASHTIMATE_DATABASE_PATH=/data/crashtimate.db
# Photos, analyses and saved estimates are deleted after this many days.
CRASHTIMATE_RETENTION_DAYS=30

# Photo analyses and saved estimates allowed per visitor per hour. 0 turns a limit off.
CRASHTIMATE_RATE_LIMIT_PER_HOUR=30
CRASHTIMATE_SHARE_RATE_LIMIT_PER_HOUR=60
# Paid photo analyses allowed per day in total, to cap spending. 0 turns it off.
CRASHTIMATE_DAILY_ANALYSIS_LIMIT=200
# Reverse proxies in front of the app: 1 on Render or Fly.io, 0 when running locally.
CRASHTIMATE_PROXY_HOPS=0
